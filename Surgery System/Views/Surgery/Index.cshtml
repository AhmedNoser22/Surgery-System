@model IEnumerable<Surgery>
@{
    ViewBag.Title = "Surgeries";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="~/css/index.css" rel="stylesheet" />

<div class="surgery-section">
    <!-- Left: Table -->
    <div style="flex: 2;">

        <!-- زر الإضافة -->
        <div class="add-surgery-wrapper">
            <a asp-action="Create" class="add-surgery-btn">
                <i class="bi bi-plus-circle"></i> Add Surgery
            </a>
        </div>

        <table class="table surgery-table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Surgery Name</th>
                    <th>Category</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var surgery in Model)
                {
                    <tr>
                        <td>
                            <img src="@Url.Content($"{FileSetting.ImagePath}/{surgery.ImageUrl}")" alt="@surgery.Name" class="surgery-img" />
                        </td>
                        <td class="fw-bold text-primary">@surgery.Name</td>
                        <td>@surgery.Category.Name</td>
                        <td class="text-center action-icons">
                            <a asp-action="Edit" asp-route-id="@surgery.Id" class="edit-icon" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a href="javascript:void(0);"
                               class="delete-icon"
                               data-id="@surgery.Id"
                               title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Right: Image & Description -->
    <div class="right-section">
        <img src="@Url.Content("~/images/nm.png")" class="right-image" alt="Surgical Room" />
        <div class="description">
            Providing advanced surgical solutions with precision and care.<br />
            Our expert team uses the latest technology to ensure optimal outcomes for every patient.
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let target = document.querySelector('.surgery-section');
            if (target) {
                target.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
    <script src="~/js/surgery.js"></script>
}
