@model CreateSurgeryVM
@{
    ViewData["Title"] = "Create Surgery";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
<link href="~/css/heart.css" rel="stylesheet" />
<h5 class="page-title">
    <i class="bi bi-heart-pulse-fill medical-icon"></i> Add a Surgery
</h5>

<div class="form-container">
    <div class="form-content">
        <form asp-action="create" method="post" enctype="multipart/form-data" class="surgery-form" novalidate>
            <div class="form-group mt-4">
                <label asp-for="Name" class="form-label"></label>
                <input type="text" class="form-control" asp-for="Name" placeholder="Enter surgery name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <label asp-for="CategoryId" class="form-label"></label>
                <select class="form-select" asp-for="CategoryId" asp-items="Model.Categories"
						data-placeholder="Select a category" data-minimum-results-for-search="Infinity">
                    <option value=""></option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <label asp-for="DeviceIds" class="form-label"></label>
                <select class="form-select" asp-for="DeviceIds" asp-items="Model.Devices" multiple
                        data-placeholder="Select a Medical device">
					<option value=""></option>
                </select>
                <span asp-validation-for="DeviceIds" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" placeholder="Enter description"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <label asp-for="Image" class="form-label"></label>
                <input type="file" class="form-control" asp-for="Image" />
                <small class="form-text text-muted">
                    Only @FileSetting.AllowedImageTypes are allowed with Max Size @FileSetting.MaxImageSize Byte
                </small>
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-submit" aria-label="Save surgery">💾 Save</button>
        </form>
    </div>

    <aside class="form-side-info" role="complementary" aria-label="Medical information about surgeries">
        <h3>Expert Surgical Care</h3>
        <p>
            Our surgical team provides world-class care combining precision, advanced technology, and compassion.<br />
            We focus on patient safety through meticulous planning and modern minimally invasive techniques.<br />
            Every procedure is tailored to the individual for optimal outcomes and faster recovery.
        </p>
        <img src="https://images.unsplash.com/photo-1526256262350-7da7584cf5eb?auto=format&fit=crop&w=512&q=80" alt="Surgeon Doctor in White Coat" style="border-radius: 15px; box-shadow: 0 6px 18px rgba(0,128,128,0.4);" />
    </aside>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/game-form.js" asp-append-version="true"></script>
}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        let target = document.querySelector('.form-container');
        if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
        }
    });
</script>


