@model UserVM

@{
    ViewData["Title"] = "Delete User";
}
<link href="~/css/deleteuser.css" rel="stylesheet" />
<h1 class="page-title">Delete User</h1>

<div class="delete-confirmation">
    <h3>Are you sure you want to delete this user?</h3>

    <div class="user-details">
        <h4>User Details</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Email)</dd>
        </dl>
    </div>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger btn-lg">Delete</button>
        <a asp-action="Index" class="btn btn-secondary btn-lg">Back to List</a>
    </form>
</div>


