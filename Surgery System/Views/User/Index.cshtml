@model IEnumerable<UserVM>

@{
    ViewData["Title"] = "Users List";
}
<link href="~/css/indexuser.css" rel="stylesheet" />

<h1 class="page-title">Users List</h1>

<p class="navigation-links">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Home</a>
</p>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="user-row">
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>
                        <a asp-action="Delete" asp-controller="User" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let firstUserRow = document.querySelector(".user-row");
        if (firstUserRow) {
            firstUserRow.scrollIntoView({ behavior: "smooth", block: "center" });
        }
    });
</script>

