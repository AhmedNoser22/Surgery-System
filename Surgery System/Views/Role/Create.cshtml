@model AddRoleVM

@{
    ViewData["Title"] = "Create Role";
}
<link href="~/css/createrole.css" rel="stylesheet" />

<h1 class="page-title">Create New Role</h1>

<div class="form-container">
    <form asp-action="Create">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <div class="form-group mb-3">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" id="roleNameInput" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group text-center">
            <input type="submit" value="Create" class="btn btn-primary" />
        </div>
    </form>
</div>

<a asp-action="Index" class="back-link">← Back to List</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let roleInput = document.getElementById("roleNameInput");
        if (roleInput) {
            roleInput.scrollIntoView({ behavior: "smooth", block: "center" });
            roleInput.focus();
        }
    });
</script>
